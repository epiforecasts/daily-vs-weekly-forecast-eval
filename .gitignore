# The manuscript quotes its result numbers from this summary, so it must be
# committed: paper.qmd reads it at render time and CI has no local/output/.
# This block must stay at the end of the file -- the *.rds rule above would
# otherwise re-ignore it, since later patterns win.
!local/output/
local/output/*
!local/output/paper_summary.rds
